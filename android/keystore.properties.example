# 릴리스 서명용 키스토어 정보.
# 이 파일을 복사해 keystore.properties 로 만들고 값을 채우세요.
# keystore.properties / *.jks 는 .gitignore로 커밋되지 않습니다.
#
# 1) 키스토어 생성 (JDK 필요):
#    keytool -genkey -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
# 2) 생성된 upload-keystore.jks 를 android/ 에 두고 아래 값 입력
# 3) npm run android:build  →  android/app/build/outputs/bundle/release/app-release.aab
#
storeFile=upload-keystore.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=upload
keyPassword=YOUR_KEY_PASSWORD
